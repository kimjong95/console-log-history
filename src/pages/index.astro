---
import CategoryCard from '../components/CategoryCard.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CARD_PREVIEW_COUNT, CATEGORY_KEYS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();

const cards = CATEGORY_KEYS.map((category) => {
	const posts = allPosts.filter((post) => post.data.category === category);
	return { category, posts: posts.slice(0, CARD_PREVIEW_COUNT), total: posts.length };
});

// 카드에 이미 나온 글은 아래 목록에서 뺀다. 글이 적을 때 같은 글이 두 번 보이지 않도록.
const previewed = new Set(cards.flatMap((card) => card.posts.map((post) => post.id)));
const rest = allPosts.filter((post) => !previewed.has(post.id));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="hero">
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_DESCRIPTION}</p>
		</section>

		<div class="doors">
			{cards.map((card) => <CategoryCard {...card} />)}
		</div>

		{
			rest.length > 0 && (
				<section class="rest">
					<h2>그 밖의 글</h2>
					<PostList posts={rest} />
				</section>
			)
		}
	</main>
</BaseLayout>

<style>
	main {
		width: var(--container);
	}
	.hero {
		margin-bottom: var(--space-4);
	}
	.hero h1 {
		margin: 0;
		font-size: 2.25em;
	}
	.hero p {
		margin: 8px 0 0;
		color: var(--muted);
	}
	.doors {
		display: grid;
		/* 카테고리 수에 맞춰 열이 늘어난다. 고정 열이면 카테고리를 늘릴 때 여기도 고쳐야 한다. */
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-2);
	}
	.rest {
		margin-top: var(--space-4);
		padding-top: var(--space-1);
		border-top: 1px solid var(--fg);
	}
	.rest h2 {
		margin-bottom: var(--space-1);
		font-size: 1.1rem;
	}
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 1.75em;
		}
	}
</style>
