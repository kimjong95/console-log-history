---
import CategoryCard from '../components/CategoryCard.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CARD_PREVIEW_COUNT, CATEGORY_KEYS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();

const cards = CATEGORY_KEYS.map((category) => {
	const posts = allPosts.filter((post) => post.data.category === category);
	return { category, posts: posts.slice(0, CARD_PREVIEW_COUNT), total: posts.length };
});

// 카드에 이미 나온 글은 아래 목록에서 뺀다. 글이 적을 때 같은 글이 두 번 보이지 않도록.
const previewed = new Set(cards.flatMap((card) => card.posts.map((post) => post.id)));
const rest = allPosts.filter((post) => !previewed.has(post.id));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="hero">
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_DESCRIPTION}</p>
		</section>

		<div class="doors">
			{cards.map((card) => <CategoryCard {...card} />)}
		</div>

		{
			rest.length > 0 && (
				<section class="rest">
					<h2>그 밖의 글</h2>
					<PostList posts={rest} />
				</section>
			)
		}
	</main>
</BaseLayout>

<style>
	main {
		width: 960px;
	}
	.hero {
		margin-bottom: 3rem;
		text-align: center;
	}
	.hero h1 {
		margin: 0;
		font-size: 2.5rem;
	}
	.hero p {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
	}
	.doors {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.rest {
		margin-top: 4rem;
	}
	.rest h2 {
		margin-bottom: 1.5rem;
		font-size: 1.2rem;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 1.9rem;
		}
	}
</style>
