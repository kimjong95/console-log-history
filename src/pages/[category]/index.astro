---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_KEYS, type Category } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
	return CATEGORY_KEYS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: Category };
const { label, description } = CATEGORIES[category];
const posts = await getPublishedPosts(category);
---

<BaseLayout title={`${label} | console.log(history)`} description={description} theme={category}>
	<main>
		<header class="section-head">
			<h1>{label}</h1>
			<p>{description}</p>
		</header>
		<PostList posts={posts} />
	</main>
</BaseLayout>

<style>
	main {
		width: 720px;
	}
	.section-head {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 2px solid var(--theme-accent);
	}
	.section-head h1 {
		margin: 0;
		font-family: var(--theme-font-label);
		font-size: 2rem;
	}
	.section-head p {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
	}
</style>
