---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_KEYS, type Category } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
	return CATEGORY_KEYS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: Category };
const { label, description } = CATEGORIES[category];
const posts = await getPublishedPosts(category);
---

<BaseLayout title={`${label} | console.log(history)`} description={description} theme={category}>
	<main>
		<header class="section-head">
			<h1>{label}</h1>
			<p>{description}</p>
		</header>
		<PostList posts={posts} />
	</main>
</BaseLayout>

<style>
	main {
		width: var(--container-prose);
	}
	.section-head {
		margin-bottom: var(--space-2);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid var(--fg);
	}
	.section-head h1 {
		margin: 0;
		color: var(--accent);
		font-family: var(--font-label);
		font-size: 1.5em;
	}
	.section-head p {
		margin: 8px 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
