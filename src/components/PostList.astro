---
import FormattedDate from './FormattedDate.astro';
import { postPath, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
	/** 글이 하나도 없을 때 대신 보여줄 문구. */
	empty?: string;
}

const { posts, empty = '아직 글이 없습니다.' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty ui-text">{empty}</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={postPath(post)}>
						<span class="title">{post.data.title}</span>
						<span class="date ui-text">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
					<p class="description">{post.data.description}</p>
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		margin: 0;
		padding: var(--space-1) 0;
		border-bottom: 1px solid var(--rule);
	}
	.post-list a {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 4px var(--space-1);
		color: var(--fg);
		text-decoration: none;
	}
	.title {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	a:hover .title {
		color: var(--accent);
	}
	.date {
		color: var(--muted);
		white-space: nowrap;
	}
	.description {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.empty {
		color: var(--muted);
	}
</style>
