---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="ui-text">
	<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	<p class="notice">
		투자 카테고리의 글은 개인 의견이며 투자 권유가 아닙니다. <a href="/about/">자세히</a>
	</p>
</footer>
<style>
	footer {
		max-width: var(--container);
		margin: var(--space-4) auto 0;
		padding: var(--space-1) var(--space-1) var(--space-3);
		box-sizing: border-box;
		border-top: 1px solid var(--rule);
		color: var(--muted);
	}
	footer p {
		margin: 0;
	}
	.notice {
		margin-top: 4px;
	}
	.notice a {
		color: var(--muted);
	}
</style>
