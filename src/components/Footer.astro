---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
	<p class="notice">
		투자 카테고리의 글은 개인 의견이며 투자 권유가 아닙니다.
		<a href="/about/">&nbsp;자세히</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 3em;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85rem;
		line-height: 1.6;
	}
	footer p {
		margin: 0;
	}
	.notice {
		margin-top: 0.35rem;
	}
	.notice a {
		color: rgb(var(--gray));
	}
</style>
