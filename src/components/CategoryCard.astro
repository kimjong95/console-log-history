---
import PostList from './PostList.astro';
import { CATEGORIES, type Category } from '../consts';
import type { Post } from '../lib/posts';

interface Props {
	category: Category;
	/** 미리 보여줄 최신 글. 없으면 카드는 제목과 설명만 보여준다. */
	posts: Post[];
	total: number;
}

const { category, posts, total } = Astro.props;
const { label, description } = CATEGORIES[category];
---

<!-- data-theme으로 그 섹션의 액센트만 바뀐다. 배경과 텍스트는 무채색이다. -->
<section class="card" data-theme={category}>
	<a class="heading" href={`/${category}/`}>
		<h2 class="label">{label}</h2>
	</a>
	<p class="description">{description}</p>
	<p class="count ui-text">글 {total}편</p>
	<PostList posts={posts} empty="첫 글을 준비하고 있습니다." />
	<a class="more ui-text" href={`/${category}/`}>전체 보기 →</a>
</section>

<style>
	.card {
		display: flex;
		flex-direction: column;
		padding-top: var(--space-1);
		border-top: 1px solid var(--fg);
	}
	.heading {
		text-decoration: none;
	}
	.label {
		margin: 0;
		color: var(--accent);
		font-family: var(--font-label);
		font-size: 1.1rem;
	}
	.description {
		margin: 8px 0 0;
		color: var(--fg);
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.count {
		margin: 4px 0 var(--space-1);
		color: var(--muted);
	}
	.more {
		margin-top: auto;
		padding-top: var(--space-1);
		color: var(--accent);
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}
</style>
