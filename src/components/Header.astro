---
import HeaderLink from './HeaderLink.astro';
import { CATEGORIES, CATEGORY_KEYS, SITE_TITLE } from '../consts';
---

<header>
	<nav class="ui-text">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			{CATEGORY_KEYS.map((category) => (
				<HeaderLink href={`/${category}/`}>{CATEGORIES[category].label}</HeaderLink>
			))}
			<HeaderLink href="/about/">소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-1);
		max-width: var(--container);
		margin: 0 auto;
		padding: var(--space-1);
		box-sizing: border-box;
	}
	/* 사이트명은 섹션 액센트를 물려받지 않는다. 브랜딩은 고정이다. */
	.brand {
		color: var(--fg);
		font-weight: 600;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav :global(a.active) {
		color: var(--fg);
	}
</style>
